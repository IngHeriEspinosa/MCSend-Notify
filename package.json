{
  "name": "mc-send-notify",
  "version": "0.1.0",
  "private": true,
  "description": "Gestor multi-tenant de envío automático de correos con IA para Multicómputos.",
  "author": "Ing. Heri Espinosa",
  "license": "GPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "next dev -p 3020",
    "dev:worker": "tsx watch --env-file-if-exists=.env src/worker/index.ts",
    "dev:all": "docker compose --profile app up --build",
    "build": "prisma generate && next build && node scripts/build-worker.mjs",
    "build:worker": "node scripts/build-worker.mjs",
    "start": "next start -p 3020",
    "start:worker": "node dist/worker/index.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --project unit",
    "test:unit": "vitest run --project unit",
    "test:int": "vitest run --project integration",
    "test:watch": "vitest --project unit",
    "test:coverage": "vitest run --project unit --coverage",
    "audit": "pnpm audit --audit-level high",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@auth/prisma-adapter": "2.11.3",
    "@aws-sdk/client-s3": "3.1144.0",
    "@aws-sdk/client-sesv2": "3.1144.0",
    "@aws-sdk/lib-storage": "3.1144.0",
    "@emotion/cache": "11.14.0",
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@mui/icons-material": "9.4.0",
    "@mui/material": "9.4.0",
    "@mui/material-nextjs": "9.4.0",
    "@mui/x-charts": "9.14.0",
    "@mui/x-data-grid": "9.14.0",
    "@multicomputos-srl/mclog": "1.3.0",
    "@node-rs/argon2": "2.2.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "bullmq": "6.3.11",
    "file-type": "22.1.1",
    "ioredis": "6.0.0",
    "juice": "12.2.0",
    "liquidjs": "10.30.0",
    "markdown-it": "15.0.2",
    "next": "16.3.8",
    "next-auth": "5.0.0-beta.32",
    "next-intl": "4.14.8",
    "nodemailer": "10.0.13",
    "papaparse": "5.7.0",
    "pg": "8.23.1",
    "pino": "10.3.1",
    "rate-limiter-flexible": "11.2.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sanitize-html": "2.18.0",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@tailwindcss/postcss": "4.3.3",
    "@types/markdown-it": "14.2.0",
    "@types/node": "26.6.3",
    "@types/nodemailer": "8.0.2",
    "@types/papaparse": "5.5.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/sanitize-html": "2.16.2",
    "@vitest/coverage-v8": "5.0.3",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "pino-pretty": "13.1.3",
    "postcss": "8.5.28",
    "prettier": "3.9.9",
    "prettier-plugin-tailwindcss": "0.8.1",
    "prisma": "7.10.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3"
  }
}
