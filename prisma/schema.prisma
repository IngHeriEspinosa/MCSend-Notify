// Esquema de datos de MC Send Notify. Autor: Ing. Heri Espinosa
// Convenciones: ids UUIDv7, timestamps en todas las tablas, tenantId en toda tabla de negocio,
// nombres de tabla y columna en snake_case mediante @@map/@map.
// Toda tabla con `tenantId` debe figurar en src/infrastructure/persistence/prisma/tenant-models.ts
// (lo verifica tests/integration/tenant-models.int.test.ts).

generator client {
  provider     = "prisma-client"
  output       = "../src/infrastructure/persistence/prisma/generated"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// ============================================================================
// Enums
// ============================================================================

enum PlatformRole {
  SUPER_ADMIN
  USER
}

enum MembershipRole {
  OWNER
  ADMIN
  EDITOR
  VIEWER
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
}

enum ContactStatus {
  ACTIVE
  UNSUBSCRIBED
  BOUNCED
  COMPLAINED
  INVALID
}

enum FieldType {
  STRING
  NUMBER
  DATE
  BOOLEAN
  SELECT
}

enum SuppressionReason {
  UNSUBSCRIBE
  HARD_BOUNCE
  COMPLAINT
  MANUAL
  INVALID
}

enum ImportStatus {
  UPLOADED
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}

enum DuplicatePolicy {
  UPDATE
  SKIP
}

enum TemplateFormat {
  BLOCKS
  MARKDOWN
  HTML
}

enum DocumentKind {
  PDF
  PRESENTATION
  DOCUMENT
  SPREADSHEET
  IMAGE
  HTML
  MARKDOWN
  TEXT
}

enum DocumentStatus {
  UPLOADED
  PROCESSING
  READY
  FAILED
}

enum EmailProviderKind {
  SMTP
  MICROSOFT_GRAPH
  RESEND
  SES
}

enum ProviderStatus {
  ACTIVE
  ERROR
  DISABLED
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  DISPATCHING
  SENDING
  PAUSED
  SENT
  CANCELLED
  FAILED
}

enum DeliveryStatus {
  QUEUED
  SENDING
  SENT
  DELIVERED
  BOUNCED
  COMPLAINED
  FAILED
  SUPPRESSED
  CANCELLED
}

enum DeliveryEventType {
  SENT
  DELIVERED
  OPENED
  CLICKED
  DOWNLOADED
  BOUNCED
  COMPLAINED
  UNSUBSCRIBED
  FAILED
}

// ============================================================================
// Plataforma e identidad
// ============================================================================

/// Cada aplicación o producto de Multicómputos (MCSupport, MCLog...) es un tenant aislado.
model Tenant {
  id                    String       @id @default(uuid(7)) @db.Uuid
  slug                  String       @unique
  name                  String
  status                TenantStatus @default(ACTIVE)
  defaultLocale         String       @default("es") @map("default_locale")
  timezone              String       @default("America/Santo_Domingo")
  /// { logoKey?, primary, accent, footerMd?, socialLinks? }
  branding              Json         @default("{}")
  /// Dirección postal obligatoria en el pie de los correos (CAN-SPAM).
  postalAddress         String?      @map("postal_address")
  /// { approvalThreshold?, attachmentMaxMb?, sendingWindow?, trackingDefaults? }
  settings              Json         @default("{}")
  onboardingStep        Int          @default(0) @map("onboarding_step")
  onboardingCompletedAt DateTime?    @map("onboarding_completed_at")
  createdAt             DateTime     @default(now()) @map("created_at")
  updatedAt             DateTime     @updatedAt @map("updated_at")

  memberships   TenantMembership[]
  invitations   Invitation[]
  apiKeys       ApiKey[]
  contacts      Contact[]
  contactFields ContactField[]
  contactLists  ContactList[]
  tags          Tag[]
  segments      Segment[]
  topics        Topic[]
  suppressions  Suppression[]
  imports       ContactImport[]
  templates     Template[]
  documents     Document[]
  providers     EmailProviderConfig[]
  senders       SenderIdentity[]
  campaigns     Campaign[]

  @@map("tenants")
}

model User {
  id               String       @id @default(uuid(7)) @db.Uuid
  email            String       @unique
  name             String?
  image            String?
  emailVerified    DateTime?    @map("email_verified")
  passwordHash     String?      @map("password_hash")
  platformRole     PlatformRole @default(USER) @map("platform_role")
  locale           String       @default("es")
  isActive         Boolean      @default(true) @map("is_active")
  /// Se incrementa para revocar todas las sesiones JWT del usuario.
  sessionVersion   Int          @default(0) @map("session_version")
  failedLoginCount Int          @default(0) @map("failed_login_count")
  lockedUntil      DateTime?    @map("locked_until")
  lastLoginAt      DateTime?    @map("last_login_at")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  accounts    Account[]
  sessions    Session[]
  memberships TenantMembership[]

  @@map("users")
}

/// Modelo estándar de Auth.js (@auth/prisma-adapter).
model Account {
  id                String   @id @default(uuid(7)) @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  type              String
  provider          String
  providerAccountId String   @map("provider_account_id")
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

/// Modelo estándar de Auth.js. Con estrategia JWT queda sin uso, pero el adapter lo requiere.
model Session {
  id           String   @id @default(uuid(7)) @db.Uuid
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id") @db.Uuid
  expires      DateTime
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
  @@map("verification_tokens")
}

model TenantMembership {
  id        String         @id @default(uuid(7)) @db.Uuid
  tenantId  String         @map("tenant_id") @db.Uuid
  userId    String         @map("user_id") @db.Uuid
  role      MembershipRole
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([userId])
  @@map("tenant_memberships")
}

/// Invitación a un tenant. Solo se guarda el hash del token; el enlace se muestra una vez.
model Invitation {
  id          String         @id @default(uuid(7)) @db.Uuid
  tenantId    String         @map("tenant_id") @db.Uuid
  email       String
  role        MembershipRole
  tokenHash   String         @unique @map("token_hash")
  expiresAt   DateTime       @map("expires_at")
  invitedById String         @map("invited_by_id") @db.Uuid
  acceptedAt  DateTime?      @map("accepted_at")
  revokedAt   DateTime?      @map("revoked_at")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, email])
  @@map("invitations")
}

/// Clave de API por tenant (`mcsn_{prefix}_{secreto}`). Solo se guarda el SHA-256 del secreto.
model ApiKey {
  id          String    @id @default(uuid(7)) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  name        String
  prefix      String    @unique
  keyHash     String    @unique @map("key_hash")
  scopes      String[]
  lastUsedAt  DateTime? @map("last_used_at")
  expiresAt   DateTime? @map("expires_at")
  revokedAt   DateTime? @map("revoked_at")
  createdById String    @map("created_by_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("api_keys")
}

/// Registro de auditoría inmutable (un trigger impide UPDATE y DELETE).
/// Sin claves foráneas: debe sobrevivir a la eliminación de las entidades que registra.
model AuditLog {
  id            String   @id @default(uuid(7)) @db.Uuid
  tenantId      String?  @map("tenant_id") @db.Uuid
  actorUserId   String?  @map("actor_user_id") @db.Uuid
  actorApiKeyId String?  @map("actor_api_key_id") @db.Uuid
  action        String
  entityType    String   @map("entity_type")
  entityId      String?  @map("entity_id")
  metadata      Json     @default("{}")
  ip            String?
  userAgent     String?  @map("user_agent")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([tenantId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

// ============================================================================
// Contactos y audiencias
// ============================================================================

model Contact {
  id              String        @id @default(uuid(7)) @db.Uuid
  tenantId        String        @map("tenant_id") @db.Uuid
  email           String
  /// Email en minúsculas y sin espacios: clave de deduplicación por tenant.
  emailNormalized String        @map("email_normalized")
  firstName       String?       @map("first_name")
  lastName        String?       @map("last_name")
  company         String?
  locale          String?
  timezone        String?
  /// Valores de los campos personalizados (ContactField.key → valor).
  attributes      Json          @default("{}")
  status          ContactStatus @default(ACTIVE)
  /// Origen del alta: manual | import | api.
  source          String        @default("manual")
  consentAt       DateTime?     @map("consent_at")
  consentSource   String?       @map("consent_source")
  externalId      String?       @map("external_id")
  lastEngagedAt   DateTime?     @map("last_engaged_at")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  tenant             Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  listMemberships    ListMembership[]
  tags               ContactTag[]
  topicSubscriptions ContactTopicSubscription[]

  @@unique([tenantId, emailNormalized])
  @@unique([tenantId, externalId])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@index([attributes], type: Gin)
  @@map("contacts")
}

/// Definición de un campo personalizado de contacto.
model ContactField {
  id        String    @id @default(uuid(7)) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  key       String
  label     String
  type      FieldType
  /// Opciones permitidas para el tipo SELECT.
  options   Json      @default("[]")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key])
  @@map("contact_fields")
}

model ContactList {
  id          String   @id @default(uuid(7)) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberships ListMembership[]
  imports     ContactImport[]

  @@unique([tenantId, name])
  @@map("contact_lists")
}

model ListMembership {
  tenantId  String   @map("tenant_id") @db.Uuid
  listId    String   @map("list_id") @db.Uuid
  contactId String   @map("contact_id") @db.Uuid
  source    String   @default("manual")
  addedAt   DateTime @default(now()) @map("added_at")

  list    ContactList @relation(fields: [listId], references: [id], onDelete: Cascade)
  contact Contact     @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@id([listId, contactId])
  @@index([tenantId, contactId])
  @@map("list_memberships")
}

model Tag {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String
  color     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant   Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contacts ContactTag[]

  @@unique([tenantId, name])
  @@map("tags")
}

model ContactTag {
  tenantId  String   @map("tenant_id") @db.Uuid
  contactId String   @map("contact_id") @db.Uuid
  tagId     String   @map("tag_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([contactId, tagId])
  @@index([tenantId, tagId])
  @@map("contact_tags")
}

/// Segmento dinámico: reglas (SegmentRuleSet validado con Zod) evaluadas en cada uso.
model Segment {
  id            String    @id @default(uuid(7)) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  name          String
  description   String?
  rules         Json
  /// Consulta en lenguaje natural que originó las reglas (Fase 4).
  nlQuery       String?   @map("nl_query")
  lastCount     Int?      @map("last_count")
  lastCountedAt DateTime? @map("last_counted_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name])
  @@map("segments")
}

/// Tema de suscripción (p. ej. "Actualizaciones de producto", "Resumen semanal").
model Topic {
  id          String   @id @default(uuid(7)) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  key         String
  /// Nombre por idioma: { es, en }.
  name        Json
  /// Descripción por idioma: { es, en }.
  description Json     @default("{}")
  /// Los contactos nuevos quedan suscritos por defecto.
  isDefault   Boolean  @default(true) @map("is_default")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant        Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscriptions ContactTopicSubscription[]

  @@unique([tenantId, key])
  @@map("topics")
}

model ContactTopicSubscription {
  tenantId   String   @map("tenant_id") @db.Uuid
  contactId  String   @map("contact_id") @db.Uuid
  topicId    String   @map("topic_id") @db.Uuid
  subscribed Boolean
  updatedAt  DateTime @updatedAt @map("updated_at")

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  topic   Topic   @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@id([contactId, topicId])
  @@index([tenantId, topicId])
  @@map("contact_topic_subscriptions")
}

/// Direcciones que nunca deben recibir envíos del tenant (bajas, rebotes, quejas).
model Suppression {
  id              String            @id @default(uuid(7)) @db.Uuid
  tenantId        String            @map("tenant_id") @db.Uuid
  emailNormalized String            @map("email_normalized")
  reason          SuppressionReason
  /// Origen: manual | import | unsubscribe | provider.
  source          String
  note            String?
  createdAt       DateTime          @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, emailNormalized])
  @@map("suppressions")
}

/// Importación de contactos desde CSV o XLSX, procesada por el worker.
model ContactImport {
  id              String          @id @default(uuid(7)) @db.Uuid
  tenantId        String          @map("tenant_id") @db.Uuid
  fileName        String          @map("file_name")
  fileType        String          @map("file_type")
  storageKey      String          @map("storage_key")
  status          ImportStatus    @default(UPLOADED)
  headers         Json            @default("[]")
  previewRows     Json            @default("[]") @map("preview_rows")
  /// columna del archivo → campo de contacto (email, firstName, attributes.<key>...).
  mapping         Json?
  duplicatePolicy DuplicatePolicy @default(UPDATE) @map("duplicate_policy")
  listId          String?         @map("list_id") @db.Uuid
  consentSource   String?         @map("consent_source")
  totalRows       Int             @default(0) @map("total_rows")
  createdCount    Int             @default(0) @map("created_count")
  updatedCount    Int             @default(0) @map("updated_count")
  skippedCount    Int             @default(0) @map("skipped_count")
  invalidCount    Int             @default(0) @map("invalid_count")
  errorReportKey  String?         @map("error_report_key")
  error           String?
  createdById     String          @map("created_by_id") @db.Uuid
  startedAt       DateTime?       @map("started_at")
  finishedAt      DateTime?       @map("finished_at")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  tenant Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  list   ContactList? @relation(fields: [listId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@map("contact_imports")
}

// ============================================================================
// Plantillas y documentos
// ============================================================================

/// Plantilla de correo. El contenido vigente se copia en una TemplateVersion inmutable en cada guardado.
model Template {
  id             String         @id @default(uuid(7)) @db.Uuid
  tenantId       String         @map("tenant_id") @db.Uuid
  name           String
  description    String?
  /// Idioma de los textos del sistema en el pie (baja, preferencias).
  locale         String         @default("es")
  format         TemplateFormat
  subject        String
  preheader      String?
  /// Contenido según el formato: { blocks } | { markdown } | { html } (templateContentSchema).
  content        Json
  /// Número de la última versión; se usa como control de concurrencia optimista.
  currentVersion Int            @default(1) @map("current_version")
  createdById    String         @map("created_by_id") @db.Uuid
  updatedById    String         @map("updated_by_id") @db.Uuid
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  versions TemplateVersion[]

  @@unique([tenantId, name])
  @@index([tenantId, updatedAt])
  @@map("templates")
}

/// Instantánea inmutable de una plantilla (historial y restauración).
model TemplateVersion {
  id          String         @id @default(uuid(7)) @db.Uuid
  tenantId    String         @map("tenant_id") @db.Uuid
  templateId  String         @map("template_id") @db.Uuid
  version     Int
  format      TemplateFormat
  subject     String
  preheader   String?
  content     Json
  locale      String
  note        String?
  createdById String         @map("created_by_id") @db.Uuid
  createdAt   DateTime       @default(now()) @map("created_at")

  template Template @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, version])
  @@index([tenantId, templateId])
  @@map("template_versions")
}

/// Documento subido por el tenant (PDF, presentación, Word, imagen, HTML, Markdown...).
/// El worker lo convierte a PDF, genera la miniatura de la primera página y extrae el texto.
model Document {
  id              String         @id @default(uuid(7)) @db.Uuid
  tenantId        String         @map("tenant_id") @db.Uuid
  /// Título visible (editable); por defecto, el nombre del archivo sin extensión.
  title           String
  fileName        String         @map("file_name")
  extension       String
  kind            DocumentKind
  mimeType        String         @map("mime_type")
  sizeBytes       Int            @map("size_bytes")
  sha256          String
  storageKey      String         @map("storage_key")
  pdfKey          String?        @map("pdf_key")
  thumbnailKey    String?        @map("thumbnail_key")
  thumbnailWidth  Int?           @map("thumbnail_width")
  thumbnailHeight Int?           @map("thumbnail_height")
  pageCount       Int?           @map("page_count")
  /// Texto extraído (primeras páginas, máx. 200 KB) para búsqueda y para la IA (Fase 4).
  extractedText   String?        @map("extracted_text")
  status          DocumentStatus @default(UPLOADED)
  error           String?
  attempts        Int            @default(0)
  createdById     String         @map("created_by_id") @db.Uuid
  processedAt     DateTime?      @map("processed_at")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([tenantId, sha256])
  @@map("documents")
}

// ============================================================================
// Envío: proveedores, remitentes, campañas, entregas y eventos
// ============================================================================

/// Proveedor de correo de un tenant. Las credenciales se guardan cifradas (AES-256-GCM).
model EmailProviderConfig {
  id                 String            @id @default(uuid(7)) @db.Uuid
  tenantId           String            @map("tenant_id") @db.Uuid
  name               String
  kind               EmailProviderKind
  /// Ajustes sin secretos (host, puerto, región, clientId...), validados por tipo con Zod.
  settings           Json              @default("{}")
  /// Credenciales cifradas: `{keyId}.{iv}.{tag}.{ct}` con AAD tenant:tabla:id.
  credentialsEnc     String?           @map("credentials_enc")
  /// Token aleatorio de la URL de webhooks entrantes (/api/webhooks/email/{token}).
  endpointToken      String            @unique @map("endpoint_token")
  rateLimitPerSecond Float             @default(10) @map("rate_limit_per_second")
  maxPerDay          Int?              @map("max_per_day")
  status             ProviderStatus    @default(ACTIVE)
  lastError          String?           @map("last_error")
  lastVerifiedAt     DateTime?         @map("last_verified_at")
  /// Se incrementa en cada cambio: invalida las conexiones cacheadas en el worker.
  configVersion      Int               @default(1) @map("config_version")
  isDefault          Boolean           @default(false) @map("is_default")
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")

  tenant  Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  senders SenderIdentity[]

  @@unique([tenantId, name])
  @@map("email_provider_configs")
}

/// Remitente (From) de un tenant y comprobación DNS de su dominio.
model SenderIdentity {
  id               String    @id @default(uuid(7)) @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  providerConfigId String    @map("provider_config_id") @db.Uuid
  fromName         String    @map("from_name")
  fromEmail        String    @map("from_email")
  replyTo          String?   @map("reply_to")
  isDefault        Boolean   @default(false) @map("is_default")
  /// { spf, dkim, dmarc }: pass | missing | fail.
  dnsCheck         Json?     @map("dns_check")
  dnsCheckedAt     DateTime? @map("dns_checked_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  tenant    Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  provider  EmailProviderConfig @relation(fields: [providerConfigId], references: [id], onDelete: Restrict)
  campaigns Campaign[]

  @@unique([tenantId, fromEmail])
  @@map("sender_identities")
}

/// Campaña: contenido (copia de la plantilla al programar), audiencia, remitente y programación.
model Campaign {
  id               String         @id @default(uuid(7)) @db.Uuid
  tenantId         String         @map("tenant_id") @db.Uuid
  name             String
  status           CampaignStatus @default(DRAFT)
  templateId       String?        @map("template_id") @db.Uuid
  templateVersion  Int?           @map("template_version")
  /// Cuerpo de la plantilla copiado al programar (TemplateBody).
  body             Json?
  /// Asunto alternativo para la prueba A/B (reparto 50/50 por destinatario).
  subjectB         String?        @map("subject_b")
  /// Correo preparado una sola vez al despachar (asunto, HTML y texto con Liquid pendiente).
  compiledSubject  String?        @map("compiled_subject")
  compiledHtml     String?        @map("compiled_html")
  compiledText     String?        @map("compiled_text")
  senderIdentityId String?        @map("sender_identity_id") @db.Uuid
  topicId          String?        @map("topic_id") @db.Uuid
  /// { listIds, segmentIds, excludeListIds } validado con Zod.
  audience         Json           @default("{}")
  scheduledAt      DateTime?      @map("scheduled_at")
  throttlePerHour  Int?           @map("throttle_per_hour")
  trackOpens       Boolean        @default(true) @map("track_opens")
  trackClicks      Boolean        @default(true) @map("track_clicks")
  /// Control de concurrencia optimista e identificador del job de despacho.
  version          Int            @default(1)
  dispatchCursor   String?        @map("dispatch_cursor") @db.Uuid
  dispatchedAt     DateTime?      @map("dispatched_at")
  recipientCount   Int            @default(0) @map("recipient_count")
  error            String?
  startedAt        DateTime?      @map("started_at")
  finishedAt       DateTime?      @map("finished_at")
  createdById      String         @map("created_by_id") @db.Uuid
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  tenant     Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sender     SenderIdentity? @relation(fields: [senderIdentityId], references: [id], onDelete: SetNull)
  deliveries Delivery[]
  links      CampaignLink[]

  @@index([tenantId, createdAt])
  @@index([status, scheduledAt])
  @@map("campaigns")
}

/// Enlace de una campaña: el clic se resuelve por id, nunca por una URL del token (sin open redirect).
model CampaignLink {
  id         String   @id @default(uuid(7)) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  campaignId String   @map("campaign_id") @db.Uuid
  position   Int
  url        String
  createdAt  DateTime @default(now()) @map("created_at")

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, position])
  @@map("campaign_links")
}

/// Entrega de una campaña a un contacto. El estado es solo de transporte; la interacción
/// (aperturas, clics) va en columnas propias y en DeliveryEvent.
model Delivery {
  id                String         @id @default(uuid(7)) @db.Uuid
  tenantId          String         @map("tenant_id") @db.Uuid
  campaignId        String         @map("campaign_id") @db.Uuid
  contactId         String         @map("contact_id") @db.Uuid
  email             String
  variant           String?
  providerConfigId  String         @map("provider_config_id") @db.Uuid
  status            DeliveryStatus @default(QUEUED)
  providerMessageId String?        @map("provider_message_id")
  attempts          Int            @default(0)
  lastError         String?        @map("last_error")
  claimedAt         DateTime?      @map("claimed_at")
  sentAt            DateTime?      @map("sent_at")
  deliveredAt       DateTime?      @map("delivered_at")
  firstOpenedAt     DateTime?      @map("first_opened_at")
  openCount         Int            @default(0) @map("open_count")
  machineOpenOnly   Boolean        @default(false) @map("machine_open_only")
  firstClickedAt    DateTime?      @map("first_clicked_at")
  clickCount        Int            @default(0) @map("click_count")
  unsubscribedAt    DateTime?      @map("unsubscribed_at")
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")

  campaign Campaign        @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  events   DeliveryEvent[]

  @@unique([campaignId, contactId])
  @@index([campaignId, status])
  @@index([providerConfigId, providerMessageId])
  @@index([status, claimedAt])
  @@map("deliveries")
}

model DeliveryEvent {
  id         String            @id @default(uuid(7)) @db.Uuid
  tenantId   String            @map("tenant_id") @db.Uuid
  deliveryId String            @map("delivery_id") @db.Uuid
  campaignId String            @map("campaign_id") @db.Uuid
  type       DeliveryEventType
  /// tracking | provider | system.
  source     String
  linkId     String?           @map("link_id") @db.Uuid
  /// HMAC de la IP con sal diaria (privacidad): permite contar sin guardar la IP.
  ipHash     String?           @map("ip_hash")
  userAgent  String?           @map("user_agent")
  isBot      Boolean           @default(false) @map("is_bot")
  metadata   Json              @default("{}")
  occurredAt DateTime          @default(now()) @map("occurred_at")

  delivery Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)

  @@index([campaignId, type])
  @@index([tenantId, occurredAt])
  @@map("delivery_events")
}

/// Evento recibido de un proveedor (webhook). Único por proveedor e id: deduplica reintentos.
model InboundWebhookEvent {
  id               String    @id @default(uuid(7)) @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  providerConfigId String    @map("provider_config_id") @db.Uuid
  providerEventId  String    @map("provider_event_id")
  type             String
  payload          Json
  processedAt      DateTime? @map("processed_at")
  receivedAt       DateTime  @default(now()) @map("received_at")

  @@unique([providerConfigId, providerEventId])
  @@index([tenantId, receivedAt])
  @@map("inbound_webhook_events")
}
