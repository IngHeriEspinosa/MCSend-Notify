# =============================================================================
# MC Send Notify: variables de entorno (plantilla versionada)
# Autor: Ing. Heri Espinosa
#
# `pnpm setup` copia este archivo a `.env` y sustituye cada marcador __NOMBRE__
# por un secreto aleatorio. Nunca se versiona `.env` ni se pegan sus valores en
# tickets, chats o documentación.
#
# Los valores de host y puerto son para desarrollo nativo (`pnpm dev`) contra la
# infraestructura de Docker. Dentro de Docker, compose.yaml usa los nombres de
# servicio internos.
# =============================================================================

# ----- Aplicación -------------------------------------------------------------
NODE_ENV=development
# development | staging | production (también se usa como entorno en MCLog)
APP_ENV=development
APP_URL=http://localhost:3020
# fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# ----- PostgreSQL ---------------------------------------------------------------
POSTGRES_USER=mcsn
POSTGRES_PASSWORD=__POSTGRES_PASSWORD__
POSTGRES_DB=mc_send_notify
DATABASE_URL=postgresql://mcsn:__POSTGRES_PASSWORD__@localhost:5452/mc_send_notify

# ----- Redis (colas BullMQ, contadores, latidos) --------------------------------
REDIS_PASSWORD=__REDIS_PASSWORD__
REDIS_URL=redis://:__REDIS_PASSWORD__@localhost:6390

# ----- Almacenamiento S3 compatible (SeaweedFS) ---------------------------------
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=mc-send-notify
S3_ACCESS_KEY_ID=mcsn-app
S3_SECRET_ACCESS_KEY=__S3_SECRET_ACCESS_KEY__
S3_FORCE_PATH_STYLE=true

# ----- Conversión de documentos (Gotenberg) -------------------------------------
GOTENBERG_URL=http://localhost:3100

# ----- Autenticación (Auth.js, Fase 1) ------------------------------------------
AUTH_SECRET=__AUTH_SECRET__
AUTH_TRUST_HOST=true
# Microsoft Entra ID (SSO). Vacíos = SSO desactivado.
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ISSUER=
AUTH_CREDENTIALS_ENABLED=true
# Dominios cuyos usuarios pueden vincular SSO y credenciales por email.
AUTH_ALLOWED_EMAIL_DOMAINS=multicomputos.com

# ----- Secretos de la plataforma (Fases 1 y 3) ----------------------------------
# Claves AES-256-GCM en formato id:base64(32 bytes), separadas por comas.
ENCRYPTION_KEYS=k1:__ENCRYPTION_KEY__
ENCRYPTION_ACTIVE_KEY_ID=k1
TRACKING_SIGNING_SECRET=__TRACKING_SIGNING_SECRET__

# ----- Correo del sistema (invitaciones, aprobaciones) --------------------------
# En desarrollo apunta a Mailpit (UI en http://localhost:8025).
SYSTEM_MAIL_SMTP_URL=smtp://localhost:1025
SYSTEM_MAIL_FROM="MC Send Notify <noreply@mcsend.local>"

# ----- IA de plataforma (opcional, Fase 4) --------------------------------------
PLATFORM_AI_ANTHROPIC_API_KEY=
PLATFORM_AI_MONTHLY_BUDGET_USD=50

# ----- Worker -------------------------------------------------------------------
WORKER_HEALTH_PORT=9464

# ----- MCLog (opcional): logs centralizados de Multicómputos --------------------
# Clave con permiso `ingest` acotada a la aplicación mc-send-notify.
# Vacías = envío a MCLog desactivado.
MCLOG_URL=
MCLOG_API_KEY=
MCLOG_APPLICATION=mc-send-notify

# ----- Datos iniciales (pnpm db:seed) -------------------------------------------
SEED_ADMIN_EMAIL=admin@multicomputos.com
SEED_ADMIN_NAME=Administrador de la plataforma

# ----- Producción (compose.prod.yaml) -------------------------------------------
# Dominio público servido por Caddy con TLS automático.
APP_DOMAIN=mcsend.example.com
